import atletas.*
import elementos.*
import disciplinas.*


/*
Casos de prueba:	
- Victoria se quiere parecer a Pareto (que mide 150 cms), se hace pequeña, practica judo y por lo tanto necesita un judogi.
- Victoria ahora se quiere parecer a Delpo y empieza a practicar tenis. Elonga con intensidad hasta llegar a los dos metros diez, necesita una raqueta y tiene dos entrenadores.
*/

describe "Casos de prueba para Victoria" {

    test "Victoria se parece a Pareto (mide 150 cm, practica judo, necesita judogi)" {
        victoria.cambiarAltura(150)
        victoria.cambiarDisciplina(judo)
        victoria.cambiarElemento(judogi)

        //verificaciones
        assert.equals(150, victoria.altura())
        assert.equals(judo, victoria.disciplina())
        assert.equals(judogi, victoria.elemento())
    }

    test "Victoria se parece a Delpo (mide 210 cm, practica tenis, necesita raqueta y 2 entrenadores)" {
        victoria.cambiarDisciplina(tenis)
        victoria.cambiarAltura(210)
        victoria.cambiarElemento(raqueta)
        tenis.entrenadores(2)

        //verificaciones
        assert.equals(210, victoria.altura())
        assert.equals(tenis, victoria.disciplina())
        assert.equals(raqueta, victoria.elemento())
        assert.equals(2, tenis.entrenadores())
    }
}